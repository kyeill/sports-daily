# Generated output is rebuilt every run -- except the history, which is the
# one thing that cannot be regenerated after the fact.
output/*
!output/history/
cache/
run.log
__pycache__/
*.pyc

# The optional Sheet template; regenerate with make_template.py
sports-daily-control.xlsx

# The Colors-tab write endpoint and its token. The Sheet is the master colour
# list; this is the only way to write to it, since the CSV endpoint READS.
secrets.json
