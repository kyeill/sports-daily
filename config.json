  "soccer_odds": {
    "_comment": "Which side's price a soccer row shows, by team rather than by who is favoured. `mine` always show their own number. Tottenham against a top-six side shows double chance instead, because the moneyline on a match they are likely to lose says little. Atlanta and the USMNT show double chance only when it is plus money. Arsenal and Chelsea are watched for who can beat them, so the OPPONENT's double chance is shown -- except against Tottenham or each other, where the rules above decide. Needs the three-way market from the core API; without it the row keeps whatever the scoreboard gave.",
    "mine": [
      "Tottenham Hotspur",
      "Atlanta United",
      "United States"
    ],
    "top_six": [
      "Arsenal",
      "Chelsea",
      "Liverpool",
      "Manchester City",
      "Manchester United"
    ],
    "double_chance_vs_top_six": [
      "Tottenham Hotspur"
    ],
    "double_chance_if_plus_money": [
      "Atlanta United",
      "United States"
    ],
    "opponent_double_chance": [
      "Arsenal",
      "Chelsea"
    ]
  },
  "upset_watch": {
    "_comment": "A ranked college side losing to, or level with, one nobody fancied: both scores turn orange. never_the_underdog keeps a rival's upset from being celebrated; never_the_favourite keeps my own team's from being.",
    "leagues": [
      "college-football",
      "mens-college-basketball"
    ],
    "never_the_underdog": [
      "Michigan State",
      "Ohio State"
    ],
    "never_the_favourite": [
      "Michigan Wolverines"
    ],
    "live": {
      "_note": "Orange while the favourite's lead is no more than `within` -- behind and level included -- but only once `after_period` is done, since an early lead says nothing yet.",
      "college-football": {
        "within": 7,
        "after_period": 1
      },
      "mens-college-basketball": {
        "within": 6,
        "after_period": 1
      }
    }
  },
  "outcome_colours": {
    "_comment": "How a finished game reads at a glance: orange for a result worth seeing, grey for one that went the wrong way. `on` is any of loss/draw for the named side. skip_when_both drops the rule when both teams are on its own list -- Ohio State against Michigan State, Arsenal against Chelsea -- where one of them losing is not news either way.",
    "good": [
      {
        "teams": [
          "Ohio State",
          "Michigan State"
        ],
        "on": [
          "loss"
        ],
        "skip_when_both": true
      },
      {
        "teams": [
          "Arsenal",
          "Chelsea"
        ],
        "on": [
          "loss",
          "draw"
        ],
        "skip_when_both": true
      }
    ],
    "bad": [
      {
        "_note": "A rival winning reads the same way as one of mine losing. Cancelled when they play each other, where the result is both at once and neither.",
        "teams": [
          "Ohio State",
          "Michigan State",
          "Arsenal",
          "Chelsea"
        ],
        "on": [
          "win"
        ],
        "skip_when_both": true
      },
      {
        "teams": [
          "Michigan Wolverines",
          "Detroit Lions",
          "Detroit Tigers",
          "Detroit Pistons",
          "Detroit Red Wings",
          "Cleveland Cavaliers",
          "Cornell Big Red"
        ],
        "on": [
          "loss"
        ]
      },
      {
        "teams": [
          "Atlanta United"
        ],
        "on": [
          "loss",
          "draw"
        ]
      },
      {
        "teams": [
          "Tottenham Hotspur"
        ],
        "on": [
          "loss"
        ]
      },
